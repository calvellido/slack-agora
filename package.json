{
  "name": "slack-agora",
  "version": "0.1.0",
  "private": true,
  "description": "Agora: a Slack bot for a team to receive messages, including anonymous ones, answer them together from a private channel, and post as the bot",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "manifest": "node --env-file-if-exists=.env src/manifest/cli.ts",
    "i18n": "node src/i18n/cli.ts",
    "clean-db": "node --env-file-if-exists=.env src/storage/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@slack/bolt": "5.1.0",
    "@slack/types": "3.2.0",
    "@slack/web-api": "8.2.0",
    "intl-messageformat": "12.1.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "7.0.2"
  }
}
