# Bot User OAuth Token (OAuth & Permissions page), starts with xoxb-
SLACK_BOT_TOKEN=
# App-Level Token with the connections:write scope (Basic Information page), starts with xapp-
SLACK_APP_TOKEN=
# ID of the team's private channel (channel details > bottom of the About tab), starts with C
TEAM_CHANNEL_ID=
# Links anonymous conversations to their authors without storing who they are. Generate it with
#   openssl rand -base64 32
# Keep a copy apart from the database: losing it hides open conversations from their authors, and anyone
# holding it and the database can work out who wrote each open conversation.
ANON_SECRET=

# The Slack app. `pnpm manifest` builds its manifest from these and from the about text below; the shortcut names
# and command descriptions come from the translations, in TEAM_LANGUAGE.
# APP_NAME=Agora
# APP_DESCRIPTION defaults to a sentence about writing to the team
# APP_DESCRIPTION="Write to the people team, with your name or anonymously"
# APP_COLOR=#212121
# PUBLISH_COMMAND=/agora-post
# ANONYMOUS_COMMAND=/agora-anon
# Bot scopes to request on top of the ones the code needs, separated by commas
# EXTRA_BOT_SCOPES=

# Language of what the bot posts in the team channel: any with a file in locales/ (en, es). Everyone else sees the
# bot in their own Slack language, or in English if there is no file for it.
# TEAM_LANGUAGE=en

# Text at the top of the Home tab, saying who is behind the bot. Slack formatting; \n starts a new line. A line that
# starts with `# ` is a large heading, in plain text, and one that starts with `-# ` is small grey text; a heading on
# the first line takes the place of the bot's name.
# ABOUT_<language> is shown to people using that language, ABOUT to everyone else. The one in TEAM_LANGUAGE is also
# the app's long description, if it has the 174 characters Slack asks for.
# ABOUT="We are the people team. Write to us about anything."
# ABOUT_ES="Somos el equipo de personas. Escríbenos sobre lo que quieras."

# Optional
# DB_PATH=data/agora.db
# A new DM from someone opens a new team channel thread after this many days without activity
# INBOX_IDLE_DAYS=7
# SEND_EMOJI=outbox_tray
# DELETE_EMOJI=wastebasket
# The icon of everything the bot posts on its own (see the README for using a custom emoji). If the workspace has no
# emoji with this name, the bot uses robot_face.
# NOTICE_EMOJI=robot_face
# A wide image across the top of the Home tab, in place of the bot's avatar. Slack fetches it, so it must be at a
# public https address. assets/agora-banner.png has the Agora logo in the middle:
# HOME_BANNER_URL=https://raw.githubusercontent.com/calvellido/slack-agora/main/assets/agora-banner.png
# Anonymous conversations end after this many days without messages
# ANON_IDLE_DAYS=30
# Days a conversation ended by the team (or by inactivity) stays visible to its author before the bot forgets them
# ANON_CLOSED_VISIBLE_DAYS=7
# Open anonymous conversations allowed per person
# ANON_MAX_OPEN=3
# LOG_LEVEL=info
