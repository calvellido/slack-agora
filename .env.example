# Bot User OAuth Token (OAuth & Permissions page), starts with xoxb-
SLACK_BOT_TOKEN=
# App-Level Token with the connections:write scope (Basic Information page), starts with xapp-
SLACK_APP_TOKEN=
# ID of the team's private channel (channel details > bottom of the About tab), starts with C
TEAM_CHANNEL_ID=
# Links anonymous conversations to their authors without storing who they are, and protects the keys of their
# encrypted text. Generate it with
#   openssl rand -base64 32
# Keep it, and any copy of it, apart from the database. Losing or changing it hides open conversations from their
# authors and leaves every encrypted conversation unreadable, so it can't be rotated without that loss. Anyone holding
# it and the database can work out who wrote each conversation not yet forgotten, and read those whose key isn't
# destroyed.
ANON_SECRET=
# Or, to keep it out of this file, in the system's keychain: leave ANON_SECRET empty, and give the command that
# prints it, which the bot runs when it starts (see "Keeping ANON_SECRET apart" in GUIDE.md, which can also generate it
# there, so that nobody knows it, at the cost of losing anonymous conversations with the machine). On Linux, or macOS:
# ANON_SECRET_COMMAND=secret-tool lookup service agora key anon_secret
# ANON_SECRET_COMMAND=security find-generic-password -a "$USER" -s agora-anon-secret -w

# The Slack app. `pnpm manifest` builds its manifest from these and from the about text below; the shortcut names
# and command descriptions come from the translations, in TEAM_LANGUAGE.
# APP_NAME=Agora
# APP_DESCRIPTION defaults to a sentence about writing to the team
# APP_DESCRIPTION="Write to the people team, with your name or anonymously"
# The text of the app's About tab, in TEAM_LANGUAGE; \n starts a new line. Slack shows it as plain text, without links,
# and needs at least 174 characters. Without it, the About tab has the ABOUT text in TEAM_LANGUAGE.
# APP_LONG_DESCRIPTION="We are the people team, the people behind this app.\nWrite to us about anything: ..."
# The background of the card with the app's details in Slack. It has to be dark: Slack refuses light colours.
# APP_COLOR=#212121
# The commands to write to the team with your name and without it. WRITE_COMMAND= (empty) leaves the first one out:
# people can still write from the bot's Messages tab, the shortcut or the Home tab.
# WRITE_COMMAND=/agora-write
# ANONYMOUS_COMMAND=/agora-anon
# Global shortcuts that open the same two forms, off by default. Slack lists them next to the commands when someone
# types /, so a command and a shortcut doing the same thing would sit side by side: the GUIDE advises against it.
# WRITE_SHORTCUT=false
# ANONYMOUS_SHORTCUT=false
# The team's command to post as the bot. Slack shows an app's commands and shortcuts to everyone in the workspace, so
# PUBLISH_COMMAND= (empty) leaves it out, and PUBLISH_SHORTCUT=false the message shortcut that posts a copy of a
# message. The team can always post from the button on the bot's Home tab, which only they see.
# PUBLISH_COMMAND=/agora-post
# PUBLISH_SHORTCUT=true
# Bot scopes to request on top of the ones the code needs, separated by commas
# EXTRA_BOT_SCOPES=

# Language of what the bot posts in the team channel: any with a file in locales/ (en, es). Everyone else sees the
# bot in their own Slack language, or in English if there is no file for it.
# TEAM_LANGUAGE=en

# Text at the top of the Home tab, saying who is behind the bot. Slack formatting; \n starts a new line. A line that
# starts with `# ` is a large heading, in plain text, and one that starts with `-# ` is small grey text; a heading on
# the first line takes the place of the bot's name.
# ABOUT_<language> is shown to people using that language, ABOUT to everyone else. The one in TEAM_LANGUAGE is also
# the About tab's text, unless APP_LONG_DESCRIPTION gives it its own.
# ABOUT="We are the people team. Write to us about anything."
# ABOUT_ES="Somos el equipo de personas. Escríbenos sobre lo que quieras."

# Optional
# DB_PATH=data/agora.db
# A new DM from someone opens a new team channel thread after this many days without activity
# INBOX_IDLE_DAYS=7
# SEND_EMOJI=outbox_tray
# DELETE_EMOJI=wastebasket
# The icon of everything the bot posts on its own (see GUIDE.md for using a custom emoji). If the workspace has no
# emoji with this name, the bot uses robot_face.
# NOTICE_EMOJI=robot_face
# A wide image across the top of the Home tab, in place of the bot's avatar. Slack fetches it, so it must be at a
# public https address. assets/agora-banner.png has the Agora logo in the middle:
# HOME_BANNER_URL=https://raw.githubusercontent.com/calvellido/slack-agora/main/assets/agora-banner.png
# HOME_TEAM_MEMBERS=true lists the people in the team channel on the Home tab, so people know who reads what they
# write. It follows the channel's members, without bots.
# HOME_TEAM_MEMBERS=false
# Where the bot's code can be read, which the bottom of the Home tab and the end of the About tab mention, inviting
# contributions. If you run a changed version, point it to yours; SOURCE_URL= (empty) leaves the note out.
# SOURCE_URL=https://github.com/calvellido/slack-agora
# Anonymous conversations end after this many days without messages
# ANON_IDLE_DAYS=30
# Days a conversation ended by the team (or by inactivity) stays visible to its author before the bot forgets them
# ANON_CLOSED_VISIBLE_DAYS=7
# Open anonymous conversations allowed per person
# ANON_MAX_OPEN=3
# Anonymous conversations are encrypted: their text is kept on the server, encrypted, and the team channel only shows
# placeholders, which the team opens to read and reply. ANON_ENCRYPTED=false keeps their text in the team channel.
# ANON_ENCRYPTED=true
# Days the team can still read an encrypted conversation after it ends, before its key, and so its text, is destroyed
# ANON_READABLE_DAYS=365
# A monitor's address, such as a Healthchecks.io check's ping URL. The bot calls it while it is connected to Slack,
# and the monitor alerts you when the calls stop (see GUIDE.md). Keep it secret: anyone with it can ping.
# HEARTBEAT_URL=https://hc-ping.com/your-check-uuid
# How often it is called, in minutes: a day by default. A shorter time, such as 5, lets the monitor alert you sooner.
# HEARTBEAT_MINUTES=1440
# LOG_LEVEL=info
